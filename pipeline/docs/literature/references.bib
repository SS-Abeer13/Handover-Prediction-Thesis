@article{wagner2025tsadmetrics,
  author  = {Wagner, Dennis and Nair, Arjun and Franks, Billy Joe and others},
  title   = {Formally Exploring Time-Series Anomaly Detection Evaluation
             Metrics},
  journal = {arXiv preprint},
  year    = {2025},
  eprint  = {2510.17562},
  archivePrefix = {arXiv},
  note    = {verified=partial (pass 3: title, id, 20 October 2025 date and the
             first three of a 24-author list confirmed; the tail of the author
             list is NOT reproduced here - COMPLETE BEFORE SUBMISSION).
             Shows formally that common point-adjusted anomaly metrics each
             satisfy only a few desirable properties and none satisfy all,
             which explains why published comparisons disagree. Direct support
             for our decision to report event-level detection rate, lead time
             and false alarms per hour and per km ALONGSIDE row-level AUPRC
             rather than instead of it.}
}

