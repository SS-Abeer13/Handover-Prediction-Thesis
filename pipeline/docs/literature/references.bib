% N. SURVIVAL / TIME-TO-EVENT METHODOLOGY  (the formulation we borrow)
% ---------------------------------------------------------------------

@article{wiegrebe2024dlsurvival,
  author  = {Wiegrebe, Simon and Kopper, Philipp and Sonabend, Raphael and
             Bischl, Bernd and Bender, Andreas},
  title   = {Deep Learning for Survival Analysis: A Review},
  journal = {Artificial Intelligence Review}, volume = {57}, number = {3},
  pages   = {65}, year = {2024}, doi = {10.1007/s10462-023-10681-3},
  note    = {verified=full (pass 3). Systematic review of 61 deep
             time-to-event methods, taxonomised by survival attribute and by
             architecture. Establishes that the discrete-time route - binary
             indicators per interval, trained as classification - is a
             mainstream branch, not an improvisation, which is the citation
             our section 7 needed. Also notes that reviewed methods evaluate
             with C-index and integrated Brier score; our horizon-wise AUPRC
             plus coherence violation rate is a deliberate departure, because
             an operator acts at one horizon, not on a ranking over all of
             them.}
}

