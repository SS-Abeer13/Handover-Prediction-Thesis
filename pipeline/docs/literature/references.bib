@article{pricewilliams2020selfexciting,
  author  = {{Price-Williams}, Matthew and Heard, Nicholas A.},
  title   = {Nonparametric Self-Exciting Models for Computer Network Traffic},
  journal = {Statistics and Computing}, volume = {30}, number = {2},
  pages   = {209--220}, year = {2020}, doi = {10.1007/s11222-019-09875-z},
  note    = {verified=full (pass 3). Wold process with a monotone step
