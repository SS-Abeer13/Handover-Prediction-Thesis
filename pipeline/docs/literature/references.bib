  journal = {Inventions}, volume = {11}, number = {1}, pages = {8},
  year    = {2026}, doi = {10.3390/inventions11010008},
  note    = {verified=full (pass 3: five authors confirmed). ns-3 simulation of
             clustered base stations with overlapping coverage; an RL agent
             decides when to hand over from signal quality and cell load.
             Reports a 4x lower handover rate with throughput maintained and
             less ping-pong. SIMULATED, KPI-only, no split protocol because
             there is no held-out prediction task - the closest recent RL
             comparator, and it shows why an RL result and a prediction result
